<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Formulaire en ligne affiche dans le choix du moyen de paiement -->
    <template id="inline_form" name="Djomy Inline Form">
        <div class="w-100">
            <label for="o_djomy_phone" class="form-label small fw-bold">
                Numéro de téléphone <span class="text-muted fw-normal">(optionnel)</span>
            </label>
            <input type="tel"
                   id="o_djomy_phone"
                   name="o_djomy_phone"
                   class="form-control"
                   placeholder="Ex : 620123456"/>
            <div class="form-text text-muted small">
                Si renseigné, le lien de paiement vous est aussi envoyé par SMS.
            </div>
        </div>
    </template>

    <!-- Formulaire de redirection (requis par le framework, le flux reel est direct) -->
    <template id="redirect_form">
        <form t-att-action="api_url" method="get"/>
    </template>

</odoo>
